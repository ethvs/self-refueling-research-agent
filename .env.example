# ===== Wallet (Robinhood Chain, chain id 4663) =====
# Private key of the agent wallet. Needs a little gas + USDG.
PRIVATE_KEY=0x...
# Robinhood Chain mainnet RPC.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# ===== Orbio gateway =====
ORBIO_API_BASE=https://api.orbio.so/api/v1
# API key is derived from a wallet signature: sk-orb-<epoch>-<base64(sig)>.
# Increase the epoch to rotate the key (old epochs become invalid on first use of the new one).
ORBIO_KEY_EPOCH=0

# ===== Contracts (defaults are the official deployments; override only if they change) =====
EXCHANGE_ADDRESS=0x6951ffd32630b05e06f50062aea801625a58ebc0
USDG_ADDRESS=0x5fc5360d0400a0fd4f2af552add042d716f1d168
CREDIT_ADDRESS=0xe33322da1380e61e5ae5dfb21e7f62924c73004c

# ===== Models (OpenRouter-style ids from GET /api/v1/models) =====
# planning (cheap) / research steps (web-grounded, returns citations) / final synthesis (strong)
CHEAP_MODEL=openai/gpt-4o-mini
SEARCH_MODEL=perplexity/sonar
STRONG_MODEL=anthropic/claude-sonnet-4.5

# ===== Credit policy =====
# Refuel when API balance (USD) drops below this.
CREDIT_LOW_THRESHOLD=2
# USDG to spend per refuel.
REFUEL_USDG=5
# Only buy when effective discount (incl. fee) >= this. 0.15 = 15%.
MIN_DISCOUNT=0.15
# Max order-book fills per purchase.
MAX_FILLS=5

# ===== Budget =====
# On-chain USDG caps (buyAndActivate); exceeding either refuses the purchase.
MAX_SPEND_PER_TASK=5
MAX_SPEND_PER_DAY=20
# Gateway (API) spend allowed per research run, in USD; beyond it the run stops and saves a partial report.
MAX_API_SPEND_PER_TASK=2

# ===== Team mode (coordinator + worker agents) =====
# Worker wallets are derived from PRIVATE_KEY (keccak256(key ‖ index)); they hold no funds.
WORKER_COUNT=3
WORKER_STEPS=2
# Worker asks the coordinator for funding below this API balance (USD).
WORKER_LOW_THRESHOLD=0.05
# USDG the coordinator spends per worker top-up via buyAndActivate(beneficiary = worker).
WORKER_FUND_USDG=0.1

# ===== Misc =====
DRY_RUN=true
LOG_LEVEL=info
REPORT_DIR=./reports
